      "conditions": {
        "companion_ids": [
          "sythia_coils"
        ]
      },
      "lines": [
        "Sythia hisses: 'Three centuries... and this is how... I fall...'"
      ]
    },
    {
      "id": "rook_inn",
      "trigger": "rest",
      "conditions": {
        "companions": [
          "rook"
        ]
      },
      "lines": [
        "Rook: 'Ale's terrible. Bed's lumpy. Perfect. Reminds me of the good old days.'"
      ]
    },
    {
      "id": "elen_inn",
      "trigger": "rest",
      "conditions": {
        "companions": [
          "sister_elen"
        ]
      },
      "lines": [
        "Sister Elen: 'A warm bed and quiet prayers. The shrine would approve.'"
      ]
    },
    {
      "id": "kess_inn",
      "trigger": "rest",
      "conditions": {
        "companions": [
          "kess"
        ]
      },
      "lines": [
        "Kess: 'I found three secret exits, two hidden compartments, and the innkeeper's secret stash. Busy night.'"
      ]
    },
    {
      "id": "voss_inn",
      "trigger": "rest",
      "conditions": {
        "companions": [
          "magister_voss"
        ]
      },
      "lines": [
        "Voss: 'I've been reading all night. Did you know this inn was built on ancient burial grounds? No? Just me?'"
      ]
    },
    {
      "id": "rose_inn",
      "trigger": "rest",
      "conditions": {
        "companions": [
          "rose_underhill"
        ]
      },
      "lines": [
        "Rose: 'Second breakfast, elevenses, lunch, afternoon tea, dinner, and supper. Productive day.'"
      ]
    },
    {
      "id": "pip_inn",
      "trigger": "rest",
      "conditions": {
        "companions": [
          "pip_sprocket"
        ]
      },
      "lines": [
        "Pip: 'I took apart the inn's clock and put it back together. It now runs backwards. Oops.'"
      ]
    },
    {
      "id": "ember_inn",
      "trigger": "rest",
      "conditions": {
        "companions": [
          "ember_skysong"
        ]
      },
      "lines": [
        "Ember: 'I tried to keep my temperature down, but I think I scorched the sheets. Again.'"
      ]
    },
    {
      "id": "nethys_inn",
      "trigger": "rest",
      "conditions": {
        "companions": [
          "nethys_websong"
        ]
      },
      "lines": [
        "Nethys: 'I may have webbed the corners of my room. Old habits. The spiders understand.'"
      ]
    },
    {
      "id": "rook_marriage",
      "trigger": "marriage",
      "conditions": {
        "companions": [
          "rook"
        ]
      },
      "lines": [
        "Rook: 'Married, eh? My condolences. Or congratulations. Whichever applies.'"
      ]
    },
    {
      "id": "elen_marriage",
      "trigger": "marriage",
      "conditions": {
        "companions": [
          "sister_elen"
        ]
      },
      "lines": [
        "Sister Elen: 'Blessings upon your union. May the shrine watch over you both.'"
      ]
    },
    {
      "id": "kess_marriage",
      "trigger": "marriage",
      "conditions": {
        "companions": [
          "kess"
        ]
      },
      "lines": [
        "Kess: 'Married! Does this mean I can't flirt with you anymore? Asking for research purposes.'"
      ]
    },
    {
      "id": "voss_marriage",
      "trigger": "marriage",
      "conditions": {
        "companions": [
          "magister_voss"
        ]
      },
      "lines": [
        "Voss: 'Fascinating. Marriage. I shall observe the dynamics closely. For science.'"
      ]
    },
    {
      "id": "veyra_marriage",
      "trigger": "marriage",
      "conditions": {
        "companions": [
          "veyra_ashhorn"
        ]
      },
      "lines": [
        "Veyra: 'Married. Let me check the contract for loopholes. Just in case.'"
      ]
    },
    {
      "id": "rose_marriage",
      "trigger": "marriage",
      "conditions": {
        "companions": [
          "rose_underhill"
        ]
      },
      "lines": [
        "Rose: 'Married! Does this mean more pie at the wedding feast? Please say yes.'"
      ]
    },
    {
      "id": "ember_marriage",
      "trigger": "marriage",
      "conditions": {
        "companions": [
          "ember_skysong"
        ]
      },
      "lines": [
        "Ember: 'Congratulations! I'm so happy I might—oh no, the curtains are on fire. Sorry.'"
      ]
