    {
      "id": "sythia_marriage",
      "trigger": "marriage",
      "conditions": {
        "companions": [
          "sythia_coils"
        ]
      },
      "lines": [
        "Sythia: 'In my three centuries, I have seen many unions. Yours shows promise.'"
      ]
    },
    {
