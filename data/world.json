  "npcs": [
    {
      "id": "innkeeper_mara",
      "name": "Mara",
      "location_id": "town_ashvale",
      "marriageable": true,
      "marriage_affinity": 60,
      "description": "Runs the inn. Has run it for a long time.",
      "gift_item_ids": ["wolf_pelt", "potion"],
      "dialogue": [
        "Bed's the same price as yesterday. So's the porridge.",
        "You look like the road's been arguing with you.",
        "Stay as long as you like. People usually don't.",
        "The well's older than the town. Don't drop anything in it."
      ]
    },
    {
      "id": "smith_dorn",
      "name": "Dorn",
      "location_id": "town_ashvale",
      "marriageable": true,
      "marriage_affinity": 70,
      "description": "The smith. Speaks mostly in prices.",
      "gift_item_ids": ["troll_hide", "bandit_coin"],
      "dialogue": [
        "Bring me steel and I'll make it worth carrying.",
        "That edge is a disgrace. Give it here.",
        "Everything breaks. Question is how loudly.",
        "Cheap armour costs more. You'll see."
      ]
    },
    {
      "id": "scholar_iven",
      "name": "Iven",
      "location_id": "town_ashvale",
      "marriageable": true,
      "marriage_affinity": 75,
      "description": "Reads too much and says so.",
      "gift_item_ids": ["shadow_essence", "slime_core"],
      "dialogue": [
        "The shrine predates the town. Nobody finds that interesting but me.",
        "Seven tiers, the old texts say. Most never pass the second.",
        "Mastery isn't talent. It's repetition nobody watched.",
        "If you find anything written down out there, bring it back intact."
      ]
    },
    {
      "id": "warden_hela",
      "name": "Warden Hela",
      "location_id": "town_emberwatch",
      "marriageable": true,
      "marriage_affinity": 75,
      "description": "Keeps the walls staffed and the fire buckets full.",
      "gift_item_ids": [
        "ember_scale",
        "greater_potion"
      ],
      "dialogue": [
        "The bell rings once for a drill, twice for fire, continuously for fools.",
        "Emberwatch was rebuilt six times. We kept the name to save paint.",
        "West road is open. Safe would be a stronger word."
      ]
    },
    {
      "id": "alchemist_pell",
      "name": "Pell",
      "location_id": "town_emberwatch",
      "marriageable": true,
      "marriage_affinity": 70,
      "description": "An alchemist whose eyebrows are recent replacements.",
      "gift_item_ids": [
        "marsh_ichor",
        "briar_heart",
        "greater_ether"
      ],
      "dialogue": [
        "Green bottle heals. Blue bottle helps magic. Striped bottle is lunch.",
        "I need marsh ichor. Need is perhaps too gentle a word.",
        "If it bubbles clockwise, leave the room calmly."
      ]
    },
    {
      "id": "cartographer_senn",
      "name": "Senn",
      "location_id": "town_emberwatch",
      "marriageable": false,
      "description": "Draws maps in erasable charcoal for practical reasons.",
      "gift_item_ids": [
        "wraith_lantern"
      ],
      "dialogue": [
        "Mosswood moved two paths again last night.",
        "Stonehaven is west, down, and louder than expected.",
        "A blank place on a map is not an invitation. Usually."
      ]
    },
    {
      "id": "reeve_marta",
      "name": "Reeve Marta",
      "location_id": "town_stonehaven",
      "marriageable": true,
      "marriage_affinity": 80,
      "description": "Runs Stonehaven by ledger, whistle, and inexhaustible disapproval.",
      "gift_item_ids": [
        "granite_core",
        "runic_gauntlets"
      ],
      "dialogue": [
        "Visitors sign in. Heroes sign twice.",
        "The mine is singing in a new key. Nobody likes it.",
        "If Tala says a tunnel is safe, it is. If Orren says it, ask Tala."
      ]
    },
    {
      "id": "miner_joss",
      "name": "Joss",
      "location_id": "town_stonehaven",
      "marriageable": true,
      "marriage_affinity": 70,
      "description": "A lift operator who has seen every depth and recommends none.",
      "gift_item_ids": [
        "greater_potion",
        "crystal_carapace"
      ],
      "dialogue": [
        "Down is easy. Coming back is skilled work.",
        "Don't whistle underground. The crystals answer.",
        "Colossus used to guard us. Pronouns changed somewhere along the way."
      ]
    },
    {
      "id": "runekeeper_ada",
      "name": "Ada",
      "location_id": "town_stonehaven",
      "marriageable": false,
      "description": "Catalogues runes by effect, age, and likelihood of explosion.",
      "gift_item_ids": [
        "wraith_lantern",
        "crystal_carapace"
      ],
      "dialogue": [
        "Old runes command. New runes negotiate.",
        "Bring me anything that glows without heat.",
        "The plateau inscriptions all point upward. Grammatically, not geographically."
      ]
    },
    {
      "id": "archivist_lume",
      "name": "Lume",
      "location_id": "town_skyreach",
      "marriageable": true,
      "marriage_affinity": 85,
      "description": "Records weather, ruins, and every traveller who returns from either.",
      "gift_item_ids": [
        "sun_fragment",
        "storm_feather"
      ],
      "dialogue": [
        "History is thinner up here. The wind takes loose pages.",
        "The Obsidian Gate predates the mountain road.",
        "Morning through the gate arrives from the wrong direction."
      ]
    },
    {
      "id": "ropewright_fenn",
      "name": "Fenn",
      "location_id": "town_skyreach",
      "marriageable": true,
      "marriage_affinity": 75,
      "description": "Trusts rope more than stone and people less than either.",
      "gift_item_ids": [
        "drake_scale",
        "gale_boots"
      ],
      "dialogue": [
        "Every bridge is a promise with knots.",
        "Check the wind, then check it again after it lies.",
        "Falling is free. Everything before it costs."
      ]
    },
    {
      "id": "abbess_sol",
      "name": "Abbess Sol",
